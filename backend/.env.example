# Copy this file to .env and fill in real values before running.
# For local dev you can leave DATABASE_URL unset - it falls back to SQLite.

# Postgres connection string for production (e.g. from Supabase/Render/Railway)
DATABASE_URL=postgresql://user:password@host:5432/trackfolio

# Any long random string - used to sign JWTs
JWT_SECRET=replace-with-a-long-random-string
